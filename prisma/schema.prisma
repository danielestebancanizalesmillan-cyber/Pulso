generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(cuid())
  name                   String
  username               String?               @unique
  email                  String?               @unique
  password               String?
  bio                    String?
  avatar                 String?
  coverImage             String?
  createdAt              DateTime              @default(now())
  isVerified             Boolean               @default(false)
  verificationType       String                @default("NONE")
  accountLabel           String?
  emailVerified          DateTime?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean               @default(false)
  location               String?
  website                String?
  image                  String?
  profileAudioUrl        String?
  profileAudioTitle      String?
  profileAudioStart      Int?                  @default(0)
  pinnedTweetId          String?
  birthDate              DateTime?
  showSensitiveContent   Boolean               @default(false)
  role                   String                @default("USER")
  countryCode            String?               @default("GLOBAL")
  isPrivate              Boolean               @default(false)
  publicKey              String?
  privateKey             String?
  aiChats                AIChat[]
  accounts               Account[]
  backupCodes            BackupCode[]
  blockedBy              Block[]               @relation("blocked")
  blocking               Block[]               @relation("blocker")
  bookmarks              Bookmark[]
  bookmarkFolders        BookmarkFolder[]
  createdCommunities     Community[]           @relation("CommunityCreator")
  communityMemberships   CommunityMember[]
  deletedConversations   DeletedConversation[]
  deletedMessages        DeletedMessage[]
  following              Follow[]              @relation("follower")
  followers              Follow[]              @relation("following")
  receivedFollowRequests FollowRequest[]       @relation("requestReceiver")
  sentFollowRequests     FollowRequest[]       @relation("requestSender")
  highlights             Highlight[]
  likes                  Like[]
  messages               Message[]
  messageReactions       MessageReaction[]
  mutedBy                Mute[]                @relation("muted")
  muting                 Mute[]                @relation("muter")
  actedNotifs            Notification[]        @relation("notifActor")
  notifications          Notification[]        @relation("notifReceiver")
  reports                Report[]              @relation("reporter")
  statuses               Status[]
  statusViews            StatusView[]
  tweets                 Tweet[]
  createdLists           TweetList[]
  listMembers            TweetListMember[]
  interests              UserInterest[]
  settings               UserSetting[]
  verificationRequest    VerificationRequest?
  conversations          Conversation[]        @relation("ConversationParticipants")
}

model AIChat {
  id        String      @id @default(cuid())
  title     String      @default("Nueva conversación")
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id        String   @id @default(cuid())
  content   String
  role      String
  chatId    String
  createdAt DateTime @default(now())
  chat      AIChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model FollowRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  receiver   User     @relation("requestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("requestSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model UserSetting {
  id     String @id @default(cuid())
  key    String
  value  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Tweet {
  id             String         @id @default(cuid())
  content        String
  createdAt      DateTime       @default(now())
  authorId       String
  parentId       String?
  retweetOfId    String?
  quoteOfId      String?
  views          Int            @default(0)
  communityId    String?
  countryCode    String?
  category       String?
  aiSources      String?
  classification String         @default("SAFE")
  bookmarks      Bookmark[]
  highlights     Highlight[]
  likes          Like[]
  notifications  Notification[]
  poll           Poll?
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community      Community?     @relation("CommunityTweets", fields: [communityId], references: [id])
  parent         Tweet?         @relation("TweetReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Tweet[]        @relation("TweetReplies")
  quoteOf        Tweet?         @relation("Quotes", fields: [quoteOfId], references: [id])
  quotes         Tweet[]        @relation("Quotes")
  retweetOf      Tweet?         @relation("Retweets", fields: [retweetOfId], references: [id])
  retweets       Tweet[]        @relation("Retweets")
  images         TweetImage[]
  hashtags       Hashtag[]      @relation("HashtagToTweet")
  locationLat    Float?
  locationLng    Float?
  locationLabel  String?
}

model Poll {
  id        String       @id @default(cuid())
  expiresAt DateTime
  tweetId   String       @unique
  tweet     Tweet        @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  options   PollOption[]
}

model PollOption {
  id     String     @id @default(cuid())
  text   String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id       String     @id @default(cuid())
  userId   String
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, optionId])
}

model BookmarkFolder {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  userId    String
  bookmarks Bookmark[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id        String          @id @default(cuid())
  userId    String
  tweetId   String
  createdAt DateTime        @default(now())
  folderId  String?
  folder    BookmarkFolder? @relation(fields: [folderId], references: [id])
  tweet     Tweet           @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
  @@index([userId])
}

model Like {
  id      String @id @default(cuid())
  userId  String
  tweetId String
  tweet   Tweet  @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  actorId   String
  tweetId   String?
  actor     User     @relation("notifActor", fields: [actorId], references: [id], onDelete: Cascade)
  tweet     Tweet?   @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user      User     @relation("notifReceiver", fields: [userId], references: [id], onDelete: Cascade)
}

model Hashtag {
  id        String   @id @default(cuid())
  text      String   @unique
  createdAt DateTime @default(now())
  tweets    Tweet[]  @relation("HashtagToTweet")
}

model Conversation {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedBy    DeletedConversation[]
  messages     Message[]
  participants User[]                @relation("ConversationParticipants")

  @@index([updatedAt])
}

model Message {
  id             String            @id @default(cuid())
  content        String
  createdAt      DateTime          @default(now())
  read           Boolean           @default(false)
  type           String            @default("text")
  audioUrl       String?
  conversationId String
  senderId       String
  isEncrypted    Boolean           @default(false)
  deletedBy      DeletedMessage[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]
}

model DeletedMessage {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageReaction {
  id        String  @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Mute {
  id      String @id @default(cuid())
  muterId String
  mutedId String
  muted   User   @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)
  muter   User   @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  tweetId   String
  createdAt DateTime @default(now())
  tweet     Tweet    @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
  @@index([userId])
}

model EmailVerification {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TweetImage {
  id      String @id @default(cuid())
  url     String
  type    String @default("image")
  tweetId String
  tweet   Tweet  @relation(fields: [tweetId], references: [id], onDelete: Cascade)
}

model TweetList {
  id          String            @id @default(cuid())
  name        String
  description String?
  isPrivate   Boolean           @default(false)
  banner      String?
  createdAt   DateTime          @default(now())
  creatorId   String
  creator     User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members     TweetListMember[]
}

model TweetListMember {
  id     String    @id @default(cuid())
  listId String
  userId String
  list   TweetList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
}

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  banner      String?
  avatar      String?
  creatorId   String
  createdAt   DateTime          @default(now())
  creator     User              @relation("CommunityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  tweets      Tweet[]           @relation("CommunityTweets")
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        String    @default("MEMBER")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

model UserInterest {
  id       String @id @default(cuid())
  userId   String
  category String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model DeletedConversation {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model BackupCode {
  id        String   @id @default(cuid())
  codeHash  String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  reporter   User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
}

model Status {
  id            String   @id @default(cuid())
  userId        String
  type          String   @default("TEXT")
  content       String?
  mediaUrl      String?
  audioUrl      String?
  background    String?
  audioStart    Int?
  audioDuration Int?     @default(15)
  styleOptions  String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  views         StatusView[]

  @@index([userId])
}

model StatusView {
  id        String   @id @default(cuid())
  statusId  String
  userId    String
  createdAt DateTime @default(now())
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId])
}
